_voxl-configure-px4(){
	local OPTS=('help enable disable crsf_gps_apm crsf_gps_noapm crsf_nogps_apm crsf_nogps_noapm spektrum_gps_apm')
	COMPREPLY=()
	if [ "$COMP_CWORD" -eq 1 ]; then
		COMPREPLY=( $(compgen -W '${OPTS}' -- ${COMP_WORDS[COMP_CWORD]}) )
		return 0
	fi
}

complete -F _voxl-configure-px4 voxl-configure-px4
